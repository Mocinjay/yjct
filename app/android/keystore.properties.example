# Release signing for the Android app.
#
# Copy to android/keystore.properties (gitignored) and fill in. Without it the
# release build comes out UNSIGNED — it deliberately does not fall back to the
# committed debug keystore, because a key that ships in a public repo signs
# nothing meaningfully and Play rejects it.
#
# CI should set CLYPSO_RELEASE_STORE_FILE / CLYPSO_RELEASE_STORE_PASSWORD /
# CLYPSO_RELEASE_KEY_ALIAS / CLYPSO_RELEASE_KEY_PASSWORD in the environment
# instead; those take precedence over this file and never touch disk.
#
# Generate a keystore with:
#   keytool -genkeypair -v -storetype PKCS12 -keystore clypso-upload.keystore \
#     -alias clypso-upload -keyalg RSA -keysize 2048 -validity 10000
#
# One keystore per developer identity — the same rule as the iOS bundle id.
# Losing it means never being able to update the listing, so back it up
# somewhere that is not this machine.

# Relative to app/android/, or absolute.
storeFile=clypso-upload.keystore
storePassword=
keyAlias=clypso-upload
keyPassword=
