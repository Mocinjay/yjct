<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides react-native-share's provider paths: clips live in the app's
     internal files dir (Documents/clips), which the library default doesn't
     expose. Keep the library's originals too. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="rnshare1" path="Download/" />
    <cache-path name="rnshare2" path="/" />
    <files-path name="rnshare3" path="/" />
</paths>
