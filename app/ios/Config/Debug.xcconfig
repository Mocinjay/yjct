// Base configuration for the Clypso target, Debug.
//
// CocoaPods normally owns `baseConfigurationReference`. This file takes it
// over and #includes the generated Pods config instead — an arrangement
// CocoaPods explicitly supports. It will print a warning on `pod install`
// saying a custom base configuration is set; that is expected and harmless
// as long as the #include below is kept.

#include "../Pods/Target Support Files/Pods-Clypso/Pods-Clypso.debug.xcconfig"

// Per-developer signing. Untracked — see Signing.xcconfig.example.
// Optional include, so a missing file degrades to an Xcode signing error
// rather than a confusing "file not found" build failure.
#include? "Signing.xcconfig"

// Xcode runs appintentsmetadataprocessor over every target containing Swift,
// and it warns once per build that it found no AppIntents.framework dependency
// and skipped. It is right: the app declares no AppIntent, AppShortcut, or
// AppEntity, so the step has nothing to extract. Skipping it drops the warning
// and changes nothing in the bundle.
//
// If App Intents are ever added — a Siri phrase, a Shortcuts action, an
// interactive Live Activity button — remove this line in the same commit, or
// they will silently fail to register.
LM_SKIP_METADATA_EXTRACTION = YES
