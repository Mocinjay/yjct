<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Clypso</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<!--
			  Must match MWDAT.AppLinkURLScheme below exactly: this is where
			  Meta AI hands control back after registration and after a
			  permission grant. MWDATBridge reads the scheme it accepts from
			  AppLinkURLScheme rather than repeating the literal, so there are
			  two copies here and no third.

			  History, because it has now bitten twice in opposite directions.
			  The scheme was "jarvis" through the Jarvis -> Clipso rename and
			  was changed to "clypso" by the Clipso -> Clypso rename (5e25bfb),
			  whose comment predicted that would break registration until a
			  matching change landed on the Meta side. It did not break it:
			  with MWDAT.MetaAppID = 0 the scheme is only a callback target,
			  not something pre-registered with Meta, and the device log shows
			  `registration=registered` under "clypso". Reverting it to
			  "jarvis" on the strength of that comment DID break registration —
			  it stalled at `registering` with no callback. See
			  docs/KNOWN-ISSUES.md issue 0.

			  So: keep this equal to AppLinkURLScheme, and do not "restore" it
			  to jarvis. The comment 5e25bfb replaced is describing a
			  production MetaAppID setup, not this one.
			-->
			<array>
				<string>clypso</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fb-viewapp</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<!-- Must equal CFBundleURLSchemes above. See the comment there. -->
		<string>clypso://</string>
		<key>MetaAppID</key>
		<string>0</string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Clypso connects to your Meta glasses over Bluetooth to buffer their camera feed.</string>
	<!--
	  NSBonjourServices is deliberately absent. It declares the service types an
	  app may BROWSE for, and nothing here browses: there is no NWBrowser and no
	  NSNetServiceBrowser anywhere in the app or in MWDAT's public surface. It
	  previously listed "_bonjour._tcp", which is not a real service type — a
	  placeholder that was never replaced. Declaring it grants nothing and
	  misdescribes the app to review. NSLocalNetworkUsageDescription below is
	  the key that actually matters, and it stays: MWDAT's WiFi Direct transport
	  needs local-network access even though it is negotiated internally.
	-->
	<key>NSCameraUsageDescription</key>
	<string>Clypso buffers video from your camera while recording so saying “Clypso” can save the last moments as a clip.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Clypso finds and streams from your Meta glasses over local Wi-Fi.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Clypso records audio with your clips and listens on-device for your trigger word. No audio leaves your phone.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Clypso transcribes your recording on-device to hear “Clypso”. Nothing is sent anywhere.</string>
	<!--
	  Read-only, and only for recordings the glasses made themselves. Meta AI
	  syncs those into the library like any other camera would, and the library
	  is the only place they can be reached from — the toolkit exposes the live
	  stream and nothing else.
	-->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Clypso reads videos your glasses recorded so it can clip them at full quality. It never changes or deletes anything in your library.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<!--
		  `audio` is what keeps the AVAudioSession mic tap alive once the app is
		  backgrounded. bluetooth-central keeps the *process* running for BT
		  events, but without `audio` iOS deactivates the session, the writer's
		  audio engine stops, and the "Clypso" wake word goes deaf.
		-->
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Montserrat-ExtraBold.ttf</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
