<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Clypso</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<!--
			  Still "jarvis" after the rename to Clypso, on purpose: this scheme
			  is registered on the Meta side as the MWDAT AppLinkURLScheme, and
			  the two must match or glasses registration never returns. Rename
			  it here only in the same change that updates the Meta app config.
			-->
			<array>
				<string>jarvis</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fb-viewapp</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>jarvis://</string>
		<key>MetaAppID</key>
		<string>0</string>
		<!--
		  Empty in Developer Mode, as in Meta's CameraAccess sample. Outside
		  Developer Mode set MWDAT_CLIENT_TOKEN in Config/Signing.xcconfig to the
		  Client Token from Wearables Developer Center; the SDK otherwise logs a
		  partial attestation configuration (TeamID present, ClientToken not).
		-->
		<key>ClientToken</key>
		<string>$(MWDAT_CLIENT_TOKEN)</string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Clypso connects to your Meta glasses over Bluetooth to buffer their camera feed.</string>
	<key>NSBonjourServices</key>
	<!--
	  `_meta-datax._tcp` is the service the Meta Wearables SDK browses for on
	  the local network (named in the 1.0 SDK binary). iOS only lets an app
	  browse service types listed here.
	-->
	<array>
		<string>_bonjour._tcp</string>
		<string>_meta-datax._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Clypso buffers video from your camera while recording so saying “Clypso” can save the last moments as a clip.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Clypso finds and streams from your Meta glasses over local Wi-Fi.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Clypso finds the videos your glasses recorded and cuts the moments you marked at full resolution. It never changes or deletes anything in your library.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Clypso records audio with your clips and listens for your trigger word while you record.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Clypso uses Apple speech recognition to hear “Clypso” while you record and to caption your clips. It runs on your iPhone where it can; otherwise Apple transcribes the audio.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<!--
		  `audio` is what keeps the AVAudioSession mic tap alive once the app is
		  backgrounded. bluetooth-central keeps the *process* running for BT
		  events, but without `audio` iOS deactivates the session, the writer's
		  audio engine stops, and the "Clypso" wake word goes deaf.
		-->
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Montserrat-ExtraBold.ttf</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
