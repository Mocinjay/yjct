<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Clypso</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<!--
			  This scheme is ALSO registered on the Meta side as the MWDAT
			  AppLinkURLScheme, and the two must match exactly or glasses
			  registration bounces into the Meta AI app and never returns —
			  silently, with no error.

			  Renamed from "jarvis" to "clypso" here. Until the matching change
			  lands in the Wearables Developer Center, registration WILL fail.
			  Change these two together or not at all.
			-->
			<array>
				<string>clypso</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fb-viewapp</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>clypso://</string>
		<key>MetaAppID</key>
		<string>0</string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Clypso connects to your Meta glasses over Bluetooth to buffer their camera feed.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Clypso buffers video from your camera while recording so saying “Clypso” can save the last moments as a clip.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Clypso finds and streams from your Meta glasses over local Wi-Fi.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Clypso records audio with your clips and listens on-device for your trigger word. No audio leaves your phone.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Clypso transcribes your recording on-device to hear “Clypso”. Nothing is sent anywhere.</string>
	<!--
	  Read-only, and only for recordings the glasses made themselves. Meta AI
	  syncs those into the library like any other camera would, and the library
	  is the only place they can be reached from — the toolkit exposes the live
	  stream and nothing else.
	-->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Clypso reads videos your glasses recorded so it can clip them at full quality. It never changes or deletes anything in your library.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<!--
		  `audio` is what keeps the AVAudioSession mic tap alive once the app is
		  backgrounded. bluetooth-central keeps the *process* running for BT
		  events, but without `audio` iOS deactivates the session, the writer's
		  audio engine stops, and the "Clypso" wake word goes deaf.
		-->
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Montserrat-ExtraBold.ttf</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
